# Required
ANTHROPIC_API_KEY=sk-ant-...
AUTH_API_KEY=replace-with-a-long-random-value

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# Optional -- omit for local dev (falls back to a local SQLite file)
# Set this to a Postgres connection string in production, e.g. from Neon:
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=

# Optional -- enables tracing in LangSmith. Get a key at smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clinical-trial-agent
